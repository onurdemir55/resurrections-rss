<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <!--
      DateParser.formatRfc822 is the current name. The old
      format_RFC1123_RFC822 remains as a @Deprecated alias so that code written
      against 1.x still compiles, and that name cannot follow Java conventions
      without defeating its purpose. Suppressed for this one file rather than
      relaxing MethodName everywhere; the suppression goes away when the alias
      is removed.
    -->
    <suppress checks="MethodName" files="[\\/]util[\\/]DateParser\.java$"/>

    <!--
      The same deprecated alias has to be exercised by its test.
    -->
    <suppress checks="MethodName" files="[\\/]util[\\/]DateParserTest\.java$"/>
</suppressions>
